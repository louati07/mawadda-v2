# ==========================================
# Mawadda Clinical HIS - Environment Configuration Example
# Copy this file to .env and customize values for your local environment
# ==========================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=Mawadda
POSTGRES_PORT=5432

# Spring Datasource Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Mawadda?currentSchema=public
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# JWT Security Key (256-bit hex or base64 string)
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
